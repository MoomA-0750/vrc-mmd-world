# scripts/win.sh と scripts/wincua.py が読む、機械ごとの設定。写して scripts/win.env にする（リポジトリには入らない）
HOST=my-windows-pc                                  # ssh のホスト名（~/.ssh/config の名前でよい）
WIN_DIR='C:/Users/me/Documents/vrc-mmd-world'       # Windows 側のリポジトリの置き場所
WIN_TEMP='C:/Users/me/AppData/Local/Temp'           # Windows 側の %TEMP%
# UNITY='C:/Program Files/Unity/Hub/Editor/2022.3.22f1/Editor/Unity.exe'
WINCUA_URL='http://192.0.2.10:8000'                 # cua computer-server（画面を撮る・操作するときだけ使う）
